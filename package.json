{
  "name": "lubomir-of-slavigrad",
  "version": "0.0.0",
  "homepage": "https://slavigrad.net",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "build:analyze": "ng build --configuration production && npm run analyze:bundle",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:coverage": "ng test --coverage",
    "analyze:bundle": "npx webpack-bundle-analyzer dist/LubomirOfSlavigrad/stats.json",
    "performance:budget": "node scripts/performance-budget.js",
    "performance:build": "npm run build:prod && npm run performance:budget",
    "performance:lighthouse": "lighthouse http://localhost:4200 --output=json --output-path=./lighthouse-report.json",
    "performance:full": "npm run build:prod && npm run performance:budget && npm run start & npm run performance:lighthouse",
    "deploy": "gh-pages -d dist/LubomirOfSlavigrad/browser"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.0.1",
    "@angular/common": "^22.0.1",
    "@angular/compiler": "^22.0.1",
    "@angular/core": "^22.0.1",
    "@angular/forms": "^22.0.1",
    "@angular/platform-browser": "^22.0.1",
    "@angular/router": "^22.0.1",
    "@lucide/angular": "^1.18.0",
    "@tailwindcss/typography": "^0.5.17",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "rxjs": "~7.8.2",
    "tailwindcss-animate": "^1.0.7",
    "tslib": "^2.6.2",
    "zone.js": "^0.16.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.1",
    "@angular/cli": "^22.0.1",
    "@angular/compiler-cli": "^22.0.1",
    "vitest": "^4.1.8",
    "@vitest/coverage-v8": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "eslint": "^9.35.0",
    "gh-pages": "^6.3.0",
    "jsdom": "^24.0.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.2"
  }
}
